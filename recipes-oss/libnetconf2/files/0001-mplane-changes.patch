+API int
+nc_server_ch_client_endpt_set_local_address(const char *client_name, const char *endpt_name, const char *address)
+{
+    struct nc_ch_client *client;
+    struct nc_ch_endpt *endpt;
+    VRB("set local address");
+    if (!client_name) {
+        ERRARG("client_name");
+        return -1;
+    } else if (!endpt_name) {
+        ERRARG("endpt_name");
+        return -1;
+    } else if (!address) {
+        ERRARG("address");
+        return -1;
+    }
+
+    /* LOCK */
+    endpt = nc_server_ch_client_lock(client_name, endpt_name, 0, &client);
+    if (!endpt) {
+        return -1;
+    }
+
+    /* Local binding address/port */
+    lydict_remove(server_opts.ctx, endpt->local_address);
+    endpt->local_address = lydict_insert(server_opts.ctx, address, 0);
+
+    /* UNLOCK */
+    nc_server_ch_client_unlock(client);
+
+    return 0;
+}
+
+API int
+nc_server_ch_client_endpt_reset_local_address(const char *client_name, const char *endpt_name)
+{
+    struct nc_ch_client *client;
+    struct nc_ch_endpt *endpt;
+    VRB("reset local address");
+    /* LOCK */
+    endpt = nc_server_ch_client_lock(client_name, endpt_name, 0, &client);
+    if (!endpt) {
+        return -1;
+    }
+
+    lydict_remove(server_opts.ctx, endpt->local_address);
+    endpt->local_address = NULL;
+
+    /* UNLOCK */
+    nc_server_ch_client_unlock(client);
+
+    return 0;
+}
