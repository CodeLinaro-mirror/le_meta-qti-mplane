+# get COMMON_INCLUDE_DIR from environment only if not already set
+if(NOT DEFINED COMMON_INCLUDE_DIR)
+    if(DEFINED ENV{COMMON_INCLUDE_DIR})
+        set(COMMON_INCLUDE_DIR "$ENV{COMMON_INCLUDE_DIR}" CACHE PATH "Path to common/src include directory")
