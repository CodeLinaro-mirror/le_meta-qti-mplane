+/**
+ * @brief Pause all call home threads for all configured call home clients.
+ *
+ * Iterates over all call home clients and sets their pause flag to 1,
+ * effectively pausing their call home threads. Thread safety is ensured
+ * by acquiring the appropriate locks.
+ *
+ * @return 0 on success, or a negative value on error.
+ */
+API int
+nc_mplane_pause_ch_threads()
+{
+    uint16_t index;
+    VRB("Received request to pause all call home threads");
+
+    // We need to go over each client, and pause the thread
+
+    // We will do a read lock for the client list, then we will lock
+    //  the client itself to pause the thread
+    /* READ LOCK */
+    pthread_rwlock_rdlock(&server_opts.ch_client_lock);
+
+    for (index = 0; index < server_opts.ch_client_count; index++)
+    {
+        VRB("Pausing ch thread for client %s",
+            server_opts.ch_clients[index].name);
+
+        /* CH CLIENT LOCK */
+        pthread_mutex_lock(&server_opts.ch_clients[index].lock);
+        server_opts.ch_clients[index].pause_ch = 1;
+        /* CH CLIENT UNLOCK */
+        pthread_mutex_unlock(&server_opts.ch_clients[index].lock);
+    }
+
+    /* READ UNLOCK */
+    pthread_rwlock_unlock(&server_opts.ch_client_lock);
+    VRB("All client flag set to pause call home thread");
+    return 0;
+}
+
+/**
+ * @brief Remove endpoints from all call home clients.
+ *
+ * Iterates over all call home clients. For each client all endpoints are removed.
+ * Thread safety is ensured by acquiring the appropriate locks.
+ *
+ * @return 0 on success, or a negative value on error.
+ */
+API int
+nc_mplane_empty_ch_client_endpoints()
+{
+    uint16_t index;
+    VRB("Received request to empty call home client data");
+
+
+    // We will do a read lock for the client list, then we will lock
+    //  the client itself to pause the thread
+    /* READ LOCK */
+    pthread_rwlock_rdlock(&server_opts.ch_client_lock);
+
+    for (index = 0; index < server_opts.ch_client_count; index++)
+    {
+        VRB("Checking client %s to remove endpoints",
+            server_opts.ch_clients[index].name);
+        /* CH CLIENT LOCK */
+        pthread_mutex_lock(&server_opts.ch_clients[index].lock);
+        /* remove all endpoints */
+        _nc_server_ch_client_del_endpt(&server_opts.ch_clients[index],
+                                        NULL,
+                                        0);
+        /* CH CLIENT UNLOCK */
+        pthread_mutex_unlock(&server_opts.ch_clients[index].lock);
+    }
+
+    /* READ UNLOCK */
+    pthread_rwlock_unlock(&server_opts.ch_client_lock);
+    VRB("All client endpoint have been removed");
+    return 0;
+}
+
+/**
+ * @brief Resume or dispatch a call home client by name.
+ *
+ * If the specified client is paused, resumes its call home thread.
+ * If the client is not paused and not connected, dispatches a new call home thread.
+ * If the client is already connected, no action is taken.
+ *
+ * @param[in] client_name Name of the call home client to resume or dispatch.
+ * @param[in] session_clb Callback function to be called when a new session is established.
+ *
+ * @return 0 on success, or a negative value on error (e.g., client not found or invalid arguments).
+ */
+API int
+nc_mplane_ch_client_resume_or_dispatch(
+                            const char *client_name,
+                            void (*session_clb)(const char *client_name,
+                                                struct nc_session *new_session))
+{
+    int ret = 0;
+    uint16_t index;
+    VRB("Resume or dispatch %s", client_name);
+
+    if (!client_name) {
+        ERRARG("client_name");
+        return -1;
+    } else if (!session_clb) {
+        ERRARG("session_clb");
+        return -1;
+    }
+
+    // We need to check if the call home thread is in pause, if that's the case
+    //  we won't create a new thread
+
+    /* READ LOCK */
+    pthread_rwlock_rdlock(&server_opts.ch_client_lock);
+    for (index = 0; index < server_opts.ch_client_count; index++)
+    {
+        if (strcmp(server_opts.ch_clients[index].name, client_name) != 0)
+        {
+            // Not our client
+            continue;
+        }
+
+        /* CH CLIENT LOCK */
+        pthread_mutex_lock(&server_opts.ch_clients[index].lock);
+
+        // Check if netconf session is established
+        if (server_opts.ch_clients[index].thread_launched != 1)
+        {
+            ret = nc_connect_ch_client_dispatch(client_name, session_clb);
+        }
+        else
+        {
+            server_opts.ch_clients[index].pause_ch = 0;
+        }
+        /* CH CLIENT UNLOCK */
+        pthread_mutex_unlock(&server_opts.ch_clients[index].lock);
+        /* READ UNLOCK */
+        pthread_rwlock_unlock(&server_opts.ch_client_lock);
+
+        return ret;
+    }
+    /* READ UNLOCK */
+    pthread_rwlock_unlock(&server_opts.ch_client_lock);
+    ERR("Client not found %s", client_name);
+    return -1;
+}
+
+/**
+ * @brief Add a new call home client if it does not already exist.
+ *
+ * Checks if a call home client with the specified name exists.
+ * If not, creates a new client using nc_server_ch_add_client().
+ *
+ * @param[in] client_name Name of the call home client to add.
+ *
+ * @return 0 if the client already exists or is added successfully,
+ *         or a negative value on error (e.g., invalid argument).
+ */
+API int
+nc_mplane_server_ch_add_client_if_not_exist(const char* client_name)
+{
+    uint16_t index;
+    if (!client_name)
+    {
+        ERRARG("client_name");
+        return -1;
+    }
+
+    // If the client already exist, do nothing, if not call
+    //  nc_server_ch_add_client
+    /* READ LOCK */
+    pthread_rwlock_rdlock(&server_opts.ch_client_lock);
+    for (index = 0; index < server_opts.ch_client_count; index++)
+    {
+        if (strcmp(server_opts.ch_clients[index].name, client_name) == 0)
+        {
+            /* READ UNLOCK */
+            pthread_rwlock_unlock(&server_opts.ch_client_lock);
+            VRB("Client %s already exists", client_name);
+            return 0;
+        }
+    }
+    /* READ UNLOCK */
+    pthread_rwlock_unlock(&server_opts.ch_client_lock);
+    VRB("Creating a new client with name: %s", client_name);
+    return nc_server_ch_add_client(client_name);
+}
