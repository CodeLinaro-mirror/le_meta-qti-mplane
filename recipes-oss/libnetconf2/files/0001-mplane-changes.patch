+API int8_t
+nc_server_update_m_plane_marking(char *addr, uint8_t value)
+{
+    // shifting by 2 as DSCP mask is (1111 1100)
+    int dscp = value << 2;
+    if (addr) {
+        for (uint8_t client_count = 0; client_count < server_opts.ch_client_count; client_count++)
+        {
+            for (uint8_t endpt_count = 0; endpt_count < server_opts.ch_clients[client_count].ch_endpt_count; endpt_count++)
+            {
+                if (!strcmp(server_opts.ch_clients[client_count].ch_endpts[endpt_count].local_address, addr))
+                {
+                    VRB("endpnt name: %s", server_opts.ch_clients[client_count].ch_endpts[endpt_count].name);
+                    VRB("endpnt sock: %d", server_opts.ch_clients[client_count].ch_endpts[endpt_count].sock);
+                    server_opts.ch_clients[client_count].ch_endpts[endpt_count].dscp = value;
+                    int sock = server_opts.ch_clients[client_count].ch_endpts[endpt_count].sock;
+                    if (sock)
+                    {
+                        int level = IPPROTO_IP;
+                        int option = IP_TOS;
+                        if (strstr(addr, "::") != NULL)
+                        {
+                            VRB("this is ipv6 protocol");
+                            level = IPPROTO_IPV6;
+                            option = IPV6_TCLASS;
+                        }
+                        if (setsockopt(sock, level, option, &dscp, sizeof dscp ) == -1)
+                        {
+                            ERR("Could not set IP_TOS socket option (%s).", strerror(errno));
+                            return -1;
+                        }
+                    }
+                    VRB("Successfully set the m_plane_marking to %d", value);
+                }
+            }
+        }
+    }
+    return 0;
+}
+
+API int8_t nc_server_get_address_and_dscp_list(char *addr[], uint8_t dscp[], uint8_t *count, uint8_t max_count)
+{
+    uint8_t MAX_ADDR_LEN = 128;
+    for (uint8_t i = 0; i < server_opts.ch_client_count; i++)
+    {
+        for (uint8_t j = 0; j < server_opts.ch_clients[i].ch_endpt_count; j++)
+        {
+            addr[*count] = calloc(1, MAX_ADDR_LEN);
+            memcpy(addr[*count], server_opts.ch_clients[i].ch_endpts[j].local_address, MAX_ADDR_LEN);
+            dscp[*count] = server_opts.ch_clients[i].ch_endpts[j].dscp;
+            (*count)++;
+            if (*count == max_count)
+            {
+                return 0;
+            }
+        }
+    }
+    return 0;
+}
