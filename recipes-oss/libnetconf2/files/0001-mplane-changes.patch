+API int8_t
+nc_server_update_m_plane_marking(char *addr, uint8_t value)
+{
+    // shifting by 2 as DSCP mask is (1111 1100)
+    int dscp = value << 2;
+    if (addr) {
+        // Lock client in read mode
+        pthread_rwlock_rdlock(&server_opts.ch_client_lock);
+        for (uint8_t client_count = 0; client_count < server_opts.ch_client_count; client_count++)
+        {
+            // Lock client
+            pthread_mutex_lock(&server_opts.ch_clients[client_count].lock);
+            for (uint8_t endpt_count = 0; endpt_count < server_opts.ch_clients[client_count].ch_endpt_count; endpt_count++)
+            {
+                if (!strcmp(server_opts.ch_clients[client_count].ch_endpts[endpt_count].local_address, addr))
+                {
+                    VRB("endpnt name: %s", server_opts.ch_clients[client_count].ch_endpts[endpt_count].name);
+                    VRB("endpnt sock: %d", server_opts.ch_clients[client_count].ch_endpts[endpt_count].sock);
+                    server_opts.ch_clients[client_count].ch_endpts[endpt_count].dscp = value;
+                    int sock = server_opts.ch_clients[client_count].ch_endpts[endpt_count].sock;
+                    if (sock)
+                    {
+                        int level = IPPROTO_IP;
+                        int option = IP_TOS;
+                        if (strstr(addr, "::") != NULL)
+                        {
+                            VRB("this is ipv6 protocol");
+                            level = IPPROTO_IPV6;
+                            option = IPV6_TCLASS;
+                        }
+                        if (setsockopt(sock, level, option, &dscp, sizeof dscp ) == -1)
+                        {
+                            ERR("Could not set IP_TOS socket option (%s).", strerror(errno));
+                            continue;
+                        }
+                    }
+                    VRB("Successfully set the m_plane_marking to %d", value);
+                }
+            }
+            // Unlock client
+            pthread_mutex_unlock(&server_opts.ch_clients[client_count].lock);
+        }
+    }
+    /* READ UNLOCK */
+    pthread_rwlock_unlock(&server_opts.ch_client_lock);
+    return 0;
+}
+
+API int8_t nc_server_get_address_and_dscp_list(char *addr[], uint8_t dscp[], uint8_t *count, uint8_t max_count)
+{
+    uint8_t MAX_ADDR_LEN = 128;
+    // Lock client in read mode
+    pthread_rwlock_rdlock(&server_opts.ch_client_lock);
+    for (uint8_t i = 0; i < server_opts.ch_client_count; i++)
+    {
+        // Lock client
+        pthread_mutex_lock(&server_opts.ch_clients[i].lock);
+        for (uint8_t j = 0; j < server_opts.ch_clients[i].ch_endpt_count; j++)
+        {
+            addr[*count] = calloc(1, MAX_ADDR_LEN);
+            memcpy(addr[*count], server_opts.ch_clients[i].ch_endpts[j].local_address, MAX_ADDR_LEN);
+            dscp[*count] = server_opts.ch_clients[i].ch_endpts[j].dscp;
+            (*count)++;
+            if (*count == max_count)
+            {
+                // Unlock client
+                pthread_mutex_unlock(&server_opts.ch_clients[i].lock);
+                /* READ UNLOCK */
+                pthread_rwlock_unlock(&server_opts.ch_client_lock);
+                return 0;
+            }
+        }
+        // Unlock client
+        pthread_mutex_unlock(&server_opts.ch_clients[i].lock);
+    }
+    /* READ UNLOCK */
+    pthread_rwlock_unlock(&server_opts.ch_client_lock);
+    return 0;
+}
+
+/**
+ * @brief Set the DSCP (Differentiated Services Code Point) value for a NETCONF call-home client endpoint.
+ *
+ * This function updates the DSCP value for the specified endpoint of a NETCONF call-home client.
+ * It locates the client and endpoint, applies the DSCP value (shifted according to the DSCP mask),
+ * and updates the socket option if the endpoint has an active socket.
+ *
+ * @param[in] client_name  Name of the NETCONF call-home client.
+ * @param[in] endpt_name   Name of the endpoint within the client.
+ * @param[in] dscp         DSCP value to set (unshifted, 6 bits).
+ *
+ * @return 0 on success, -1 on error (invalid arguments, endpoint not found, or socket option failure).
+ *
+ * @note The DSCP value is shifted left by 2 bits before being set, as per the DSCP mask (0xFC).
+ *       If the endpoint uses IPv6, the IPV6_TCLASS socket option is set; otherwise, IP_TOS is used.
+ *       The function acquires and releases locks on the client structure for thread safety.
+ */
+API int8_t nc_mplane_server_ch_client_endpt_set_dscp(const char *client_name,
+                                                  const char *endpt_name,
+                                                  uint8_t dscp)
+{
+    struct nc_ch_client *client;
+    struct nc_ch_endpt *endpt;
+    VRB("set dscp to client %s, endpt %s, dscp value %d",
+        client_name,
+        endpt_name,
+        dscp);
+    if (!client_name) {
+        ERRARG("client_name");
+        return -1;
+    } else if (!endpt_name) {
+        ERRARG("endpt_name");
+        return -1;
+    }
+
+    /* LOCK */
+    endpt = nc_server_ch_client_lock(client_name, endpt_name, 0, &client);
+    if (!endpt) {
+        ERR("Unable to get endpoint");
+        return -1;
+    }
+
+    // shifting by 2 as DSCP mask is (1111 1100)
+    int shifted_dscp = dscp << 2;
+    endpt->dscp = shifted_dscp;
+    if (endpt->sock)
+    {
+        int level = IPPROTO_IP;
+        int option = IP_TOS;
+        if (strstr(endpt->local_address, "::") != NULL)
+        {
+            VRB("this is ipv6 protocol");
+            level = IPPROTO_IPV6;
+            option = IPV6_TCLASS;
+        }
+        if (setsockopt(endpt->sock, level, option, &shifted_dscp, sizeof shifted_dscp ) == -1)
+        {
+            ERR("Could not set IP_TOS socket option (%s).", strerror(errno));
+        }
+    }
+
+    /* UNLOCK */
+    nc_server_ch_client_unlock(client);
+
+    return 0;
+}
+
+API uint64_t
+nc_server_get_next_libnetconf2_rumplane_msg_id()
+{
+    if(libnetconf2_msg_id > MAX_LIBNETCONF2_MESSAGE_ID) {
+        libnetconf2_msg_id = START_LIBNETCONF2_MESSAGE_ID;
+    }
+    return libnetconf2_msg_id++;
+}
