+// Counter of number of ru_controller libnetconf will try the re-call-home
+//  procedure
+unsigned _Atomic g_ru_controller_counter = ATOMIC_VAR_INIT(0);
+pthread_mutex_t g_reset_callback_used_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+int8_t check_call_reset()
+{
+    if (pthread_mutex_lock(&g_reset_callback_used_mutex) != 0)
+    {
+        ERR("Failed to lock mutex");
+        return -1;
+    }
+
+    nc_server_ch_exceeded_clb clb = nc_server_get_call_home_exeeded_cb();
+    atomic_fetch_sub(&g_ru_controller_counter, 1);
+    if (atomic_load(&g_ru_controller_counter) != 0)
+    {
+        VRB(
+            "Still %u clients to continue doing the re-call-home "
+            "attempt. Do not call reset",
+            atomic_load(&g_ru_controller_counter));
+    }
+    else if (clb)
+    {
+        VRB("No more clients available for re-call-home. Using the callback");
+        clb();
+    }
+    else
+    {
+        ERR("No reset callback provided");
+    }
+
+    pthread_mutex_unlock(&g_reset_callback_used_mutex);
+    return 0;
+}
