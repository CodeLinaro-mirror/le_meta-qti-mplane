+API int nc_server_connect_to_rumplane(uint32_t nc_session_id,
+                                        const char *ncServerLocalAddr)
+{
+    int sock = -1, ret = -1;
+    uint8_t is_NcServerLocalAddrIpv4 = -1;
+    struct sockaddr_in server_addr;
+    fd_set writefds;
+    struct timeval tv;
+    ssize_t bytes_sent;
+
+    if (!ncServerLocalAddr ||
+            strlen(ncServerLocalAddr) >= MAX_NC_SERVER_LOCAL_ADDR_LEN) {
+        ERRARG("ncServerLocalAddr is NULL or invalid");
+        return -1;
+    }
+
+    is_NcServerLocalAddrIpv4 = (!strchr(ncServerLocalAddr, ':')) ? 1 : 0;
+
+    sock = socket(AF_INET, SOCK_STREAM, 0);
+    if (sock == -1) {
+        ERR("Failed to create socket (%s).", strerror(errno));
+        goto cleanup;
+    }
+    int flags = fcntl(sock, F_GETFL, 0);
+    if (flags == -1 || fcntl(sock, F_SETFL, flags | O_NONBLOCK) == -1) {
+        ERR("Failed to set non-blocking mode (%s).", strerror(errno));
+        goto cleanup;
+    }
+
+    memset(&server_addr, 0, sizeof(server_addr));
+    server_addr.sin_family = AF_INET;
+    server_addr.sin_port = htons(RU_MPLANE_PORT);
+
+    if (inet_pton(AF_INET, RU_MPLANE_ADDR, &server_addr.sin_addr) <= 0) {
+        ERR("Invalid IP address (%s).", RU_MPLANE_ADDR);
+        goto cleanup;
+    }
+
+    VRB("Trying to connect to RuMplane..");
+    if (connect(sock,
+                (struct sockaddr *)&server_addr,
+                sizeof(server_addr)) < 0) {
+        if(errno != EINPROGRESS) {
+            ERR("Failed to connect to ruMplane app at %s:%u (%s).",
+                RU_MPLANE_ADDR, RU_MPLANE_PORT, strerror(errno));
+            goto cleanup;
+        }
+
+        FD_ZERO(&writefds);
+        // to check when the socket becomes writable, we're using select()
+        FD_SET(sock, &writefds);
+        tv.tv_sec = 1;
+        tv.tv_usec = 0;
+
+        ret = select(sock + 1, NULL, &writefds, NULL, &tv);
+        if (ret <= 0) {
+            ERR("Connection to RuMplane app at %s:%u timed out or failed.",
+                RU_MPLANE_ADDR, RU_MPLANE_PORT);
+            goto cleanup;
+        }
+
+        int so_error;
+        socklen_t len = sizeof(so_error);
+        if (getsockopt(sock, SOL_SOCKET, SO_ERROR, &so_error, &len) < 0 || so_error != 0) {
+            ERR("Connection error to RuMplane app at %s:%u (%s).",
+                RU_MPLANE_ADDR, RU_MPLANE_PORT, strerror(so_error));
+            goto cleanup;
+        }
+    }
+
+    VRB("Connected to RuMplane app at %s:%u.", RU_MPLANE_ADDR, RU_MPLANE_PORT);
+
+    // Prepare packet to be sent to ruMplane app
+    InterfacePacket_t pkt;
+    Libnetconf2Message_t msg;
+    memset(&pkt, 0, sizeof(pkt));
+    memset(&msg, 0, sizeof(msg));
+
+    pkt.header.msgType = NOTIFICATION;
+    pkt.header.msgSubType = LIBNETCONF2;
+    pkt.header.oduOrOruSessionId = nc_session_id;
+    pkt.header.messageId = nc_server_get_next_libnetconf2_rumplane_msg_id();
+    pkt.header.payloadSize =
+        sizeof(msg.msgType) + sizeof(msg.lenOfNcServerLocalAddr) +
+        sizeof(msg.isNcServerLocalAddrIpv4) + strlen(ncServerLocalAddr);
+
+    msg.msgType = NC_SERVER_INFO;       // type of message
+    msg.lenOfNcServerLocalAddr = strlen(ncServerLocalAddr);
+    msg.isNcServerLocalAddrIpv4 = is_NcServerLocalAddrIpv4;
+    memcpy(msg.ncServerLocalAddr,
+            ncServerLocalAddr,
+            MAX_NC_SERVER_LOCAL_ADDR_LEN);
+    memcpy(pkt.payload, &msg, pkt.header.payloadSize);
+
+    bytes_sent = send(
+        sock, &pkt, sizeof(InterfaceHeader_t) + pkt.header.payloadSize, 0);
+    if (bytes_sent == -1) {
+        ERR("Failed to send info message (%s).", strerror(errno));
+        goto cleanup;
+    }
+    if ((size_t)bytes_sent < sizeof(InterfaceHeader_t) + pkt.header.payloadSize) {
+        ERR("Only sent %zd of %zu bytes for data message.", 
+            bytes_sent, sizeof(InterfaceHeader_t) + pkt.header.payloadSize);
+        goto cleanup;
+    }
+
+    VRB("netconf server local IP: \"%s\", for session: %d sent to RuMplane",
+            ncServerLocalAddr, nc_session_id);
+    ret = 0;
+
+cleanup:
+    if (sock != -1) close(sock);
+    return ret;
+}
