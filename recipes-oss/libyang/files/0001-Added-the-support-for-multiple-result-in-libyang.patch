From d53d017e7121a0702444b9eb833bc022fc70c526 Mon Sep 17 00:00:00 2001
From: Balram Panwar <quic_panwar@quicinc.com>
Date: Wed, 10 Apr 2024 10:18:11 -0700
Subject: [PATCH] Added the support for multiple result in libyang

Signed-off-by: Balram Panwar <quic_panwar@quicinc.com>
---
 src/tree_data.c     | 82 ++++++++++++++++++++++++++-------------------
 src/tree_internal.h |  2 +-
 2 files changed, 48 insertions(+), 36 deletions(-)

diff --git a/src/tree_data.c b/src/tree_data.c
index 1f7123a09..14dd83761 100644
--- a/src/tree_data.c
+++ b/src/tree_data.c
@@ -45,6 +45,9 @@ static struct lyd_node *lyd_dup_withsiblings_to_ctx(const struct lyd_node *node,
 static struct lyd_node *lyd_new_dummy(struct lyd_node *root, struct lyd_node *parent, const struct lys_node *schema,
                                       const char *value, int dflt);
 
+static int lyd_difflist_add(struct lyd_difflist *diff, unsigned int *size, unsigned int index,
+                 LYD_DIFFTYPE type, struct lyd_node *first, struct lyd_node *second);
+
 static int
 lyd_anydata_equal(struct lyd_node *first, struct lyd_node *second)
 {
@@ -132,7 +135,7 @@ lyd_leaf_val_equal(struct lyd_node *node1, struct lyd_node *node2, int diff_ctx)
  * 1 - only change is that if 2 nodes have the same value, but one is default, the other not, they are considered non-equal
  */
 int
-lyd_list_equal(struct lyd_node *node1, struct lyd_node *node2, int with_defaults)
+lyd_list_equal(struct lyd_node *node1, struct lyd_node *node2, int with_defaults, struct lyd_difflist *diff, unsigned int *size, unsigned int *index)
 {
     int i, diff_ctx;
     struct lyd_node *elem1, *next1, *elem2, *next2;
@@ -221,7 +224,16 @@ lyd_list_equal(struct lyd_node *node1, struct lyd_node *node2, int with_defaults
                     /* we will compare all the children of this list instance, not just keys */
                 } else if (elem2->schema->nodetype & (LYS_LEAFLIST | LYS_LEAF)) {
                     if (!lyd_leaf_val_equal(elem1, elem2, diff_ctx) && (!with_defaults || (elem1->dflt == elem2->dflt))) {
-                        break;
+                        if(diff == NULL || size == NULL || index == NULL ) {
+                            LOGERR(ctx, LY_EINVAL, "%s: There is no value for diff, size and index in case of multiple result", __func__);
+                            break;
+                        }
+                        if (lyd_difflist_add(diff, size, (*index)++, LYD_DIFF_CHANGED, elem1, elem2)) {
+                            LOGERR(ctx, LY_EINVAL, "%s: failed to add the diff leaf in case of multiple result", __func__);
+                            return -1;
+                        }
+                        assert(!(elem1->validity & LYD_VAL_INUSE));
+                        elem1->validity |= LYD_VAL_INUSE;
                     }
                 } else if (elem2->schema->nodetype & LYS_ANYDATA) {
                     if (!lyd_anydata_equal(elem1, elem2)) {
@@ -309,7 +321,7 @@ lyd_hash_table_val_equal(void *val1_p, void *val2_p, int mod, void *UNUSED(cb_da
         return 1;
     case LYS_LEAFLIST:
     case LYS_LIST:
-        return lyd_list_equal(val1, val2, 0);
+        return lyd_list_equal(val1, val2, 0, NULL, NULL, NULL);
     default:
         break;
     }
@@ -2699,7 +2711,7 @@ lyd_merge_node_equal(struct lyd_node *node1, struct lyd_node *node2)
             return 0;
         }
 
-        ret = lyd_list_equal(node1, node2, 1);
+        ret = lyd_list_equal(node1, node2, 1, NULL, NULL, NULL);
         if ((ret == 1) && (node1->schema->flags & LYS_CONFIG_R)) {
             /* mark it as matched */
             node1->validity |= LYD_VAL_INUSE;
@@ -2713,7 +2725,7 @@ lyd_merge_node_equal(struct lyd_node *node1, struct lyd_node *node2)
             return 0;
         }
 
-        ret = lyd_list_equal(node1, node2, 1);
+        ret = lyd_list_equal(node1, node2, 1, NULL, NULL, NULL);
         if ((ret == 1) && !((struct lys_node_list *)node1->schema)->keys_size) {
             /* mark it as matched */
             node1->validity |= LYD_VAL_INUSE;
@@ -3362,7 +3374,7 @@ diff_ordset_free(struct ly_set *set)
  *  1 - first and second not the same
  */
 static int
-lyd_diff_compare(struct lyd_node *first, struct lyd_node *second, int options)
+lyd_diff_compare(struct lyd_node *first, struct lyd_node *second, int options, struct lyd_difflist *diff, unsigned int *size, unsigned int *index)
 {
     int rc;
 
@@ -3379,7 +3391,7 @@ lyd_diff_compare(struct lyd_node *first, struct lyd_node *second, int options)
             return 1;
         }
 
-        rc = lyd_list_equal(first, second, (options & LYD_DIFFOPT_WITHDEFAULTS ? 1 : 0));
+        rc = lyd_list_equal(first, second, (options & LYD_DIFFOPT_WITHDEFAULTS ? 1 : 0), diff, size, index);
         if (rc == -1) {
             return -1;
         } else if (!rc) {
@@ -3472,7 +3484,7 @@ lyd_diff_equivnode(struct lyd_node *first, struct lyd_node *second)
         }
         if (iter1->schema->nodetype == LYS_LIST) {
             /* compare keys */
-            if (lyd_list_equal(iter1, iter2, 0) != 1) {
+            if (lyd_list_equal(iter1, iter2, 0, NULL, NULL, NULL ) != 1) {
                 return 0;
             }
         }
@@ -3727,29 +3739,29 @@ lyd_diff(struct lyd_node *first, struct lyd_node *second, int options)
         }
 
 #ifdef LY_ENABLED_CACHE
-        struct lyd_node **iter_p;
-
-        if (elem1 && elem1->parent && elem1->parent->ht) {
-            iter = NULL;
-            if (!lyht_find(elem1->parent->ht, &elem2, elem2->hash, (void **)&iter_p)) {
-                iter = *iter_p;
-                /* we found a match */
-                if (iter->dflt && !(options & LYD_DIFFOPT_WITHDEFAULTS)) {
-                    /* the second one cannot be default (see lyd_diff()),
-                     * so the nodes differs (first one is default node) */
-                    iter = NULL;
-                }
-                while (iter && (iter->validity & LYD_VAL_INUSE)) {
-                    /* state lists, find one not-already-found */
-                    assert((iter->schema->nodetype & (LYS_LIST | LYS_LEAFLIST)) && (iter->schema->flags & LYS_CONFIG_R));
-                    if (lyht_find_next(elem1->parent->ht, &iter, iter->hash, (void **)&iter_p)) {
-                        iter = NULL;
-                    } else {
-                        iter = *iter_p;
-                    }
-                }
-            }
-        } else
+        // struct lyd_node **iter_p;
+
+        // if (elem1 && elem1->parent && elem1->parent->ht) {
+        //     iter = NULL;
+        //     if (!lyht_find(elem1->parent->ht, &elem2, elem2->hash, (void **)&iter_p)) {
+        //         iter = *iter_p;
+        //         /* we found a match */
+        //         if (iter->dflt && !(options & LYD_DIFFOPT_WITHDEFAULTS)) {
+        //             /* the second one cannot be default (see lyd_diff()),
+        //              * so the nodes differs (first one is default node) */
+        //             iter = NULL;
+        //         }
+        //         while (iter && (iter->validity & LYD_VAL_INUSE)) {
+        //             /* state lists, find one not-already-found */
+        //             assert((iter->schema->nodetype & (LYS_LIST | LYS_LEAFLIST)) && (iter->schema->flags & LYS_CONFIG_R));
+        //             if (lyht_find_next(elem1->parent->ht, &iter, iter->hash, (void **)&iter_p)) {
+        //                 iter = NULL;
+        //             } else {
+        //                 iter = *iter_p;
+        //             }
+        //         }
+        //     }
+        // } else
 #endif
         {
             /* search for elem2 instance in the first */
@@ -3759,7 +3771,7 @@ lyd_diff(struct lyd_node *first, struct lyd_node *second, int options)
                 }
 
                 /* elem2 instance found */
-                rc = lyd_diff_compare(iter, elem2, options);
+                rc = lyd_diff_compare(iter, elem2, options, result, &size, &index);
                 if (rc == -1) {
                     goto error;
                 } else if (rc == 0) {
@@ -6698,7 +6710,7 @@ lyd_find_sibling(const struct lyd_node *siblings, const struct lyd_node *target,
             }
 
             if (target->schema->nodetype & (LYS_LIST | LYS_LEAFLIST)) {
-                if (lyd_list_equal((struct lyd_node *)target, (struct lyd_node *)siblings, 0)) {
+                if (lyd_list_equal((struct lyd_node *)target, (struct lyd_node *)siblings, 0, NULL, NULL, NULL)) {
                     /* a match */
                     break;
                 }
@@ -6780,7 +6792,7 @@ lyd_find_sibling_set(const struct lyd_node *siblings, const struct lyd_node *tar
                     continue;
                 }
 
-                if (lyd_list_equal((struct lyd_node *)target, (struct lyd_node *)siblings, 0)) {
+                if (lyd_list_equal((struct lyd_node *)target, (struct lyd_node *)siblings, 0, NULL, NULL, NULL)) {
                     /* a match */
                     if (ly_set_add(*set, (struct lyd_node *)siblings, LY_SET_OPT_USEASLIST) == -1) {
                         goto error;
@@ -8134,7 +8146,7 @@ lyd_defaults_add_unres(struct lyd_node **root, int options, struct ly_ctx *ctx,
                     while (data_tree_sibling) {
                         if ((data_tree_sibling->schema == msg_sibling->schema)
                                 && ((msg_sibling->schema->nodetype != LYS_LIST)
-                                    || lyd_list_equal(data_tree_sibling, msg_sibling, 0))) {
+                                    || lyd_list_equal(data_tree_sibling, msg_sibling, 0, NULL, NULL, NULL))) {
                             /* match */
                             break;
                         }
diff --git a/src/tree_internal.h b/src/tree_internal.h
index 36e94f5c5..2019f6623 100644
--- a/src/tree_internal.h
+++ b/src/tree_internal.h
@@ -506,7 +506,7 @@ int lyd_build_relative_data_path(const struct lys_module *module, const struct l
 void lyd_free_value(lyd_val value, LY_DATA_TYPE value_type, uint8_t value_flags, struct lys_type *type,
                     const char *value_str, lyd_val *old_val, LY_DATA_TYPE *old_val_type, uint8_t *old_val_flags);
 
-int lyd_list_equal(struct lyd_node *node1, struct lyd_node *node2, int with_defaults);
+int lyd_list_equal(struct lyd_node *node1, struct lyd_node *node2, int with_defaults, struct lyd_difflist *diff, unsigned int *size, unsigned int *index);
 
 int lys_make_implemented_r(struct lys_module *module, struct unres_schema *unres);
 
