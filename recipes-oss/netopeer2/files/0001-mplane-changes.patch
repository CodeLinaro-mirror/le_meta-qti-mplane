+static int
+np2srv_rpc_subscribe_append_str(const char *str, char **ret)
+{
+    void *mem = NULL;
+    int len;
+
+    if (!ret)
+    {
+        EINT;
+        return SR_ERR_INTERNAL;
+    }
+
+    if (!*ret) {
+        *ret = strdup(str);
+        if (!*ret) {
+            EMEM;
+            return SR_ERR_NOMEM;
+        }
+    } else {
+        len = strlen(*ret);
+        // Realloc ret
+        mem = realloc(*ret, len + strlen(str) + 1);
+        if (!mem) {
+            EMEM;
+            return SR_ERR_NOMEM;
