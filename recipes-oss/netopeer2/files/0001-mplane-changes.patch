+/**
+ * @brief LibSSH logging callback function.
+ *
+ * Map the LibSSH logging level to Netopeer logging level and call the
+ * Netopeer logging function with parameter message.
+ *
+ * @param[in] priority Priority of the log, the smaller being the more important.
+ * @param[in] function The function name calling the the logging fucntions.
+ * @param[in] message  The actual message
+ * @param[in] userdata Userdata to be passed to the callback function.
+ */
+void
+np2log_cb_sh(int priority, const char *function, const char *buffer, void *userdata)
+{
+    (void)function;
+    (void)userdata;
+    int np2_priority = LOG_ERR;
+
+    /* For debug purposes, print the message in yellow to distinquish SSH log
+     * messages from other OSS component log messages. */
+    const char* yellow = "\033[0;33m";
+    const char* reset = "\033[0m";
+
+    /* SSH log levels are:
+     * SSH_LOG_NOLOG - No logging at all
+     * SSH_LOG_WARNING - Only warnings
+     * SSH_LOG_PROTOCOL - High level protocol information
+     * SSH_LOG_PACKET - Lower level protocol infomations, packet level
+     * SSH_LOG_FUNCTIONS -  Every function path
+     */
+
+    if (priority > np2_libssh_verbose_level) {
+        return;
+    }
+
+    switch (priority) {
+    case SSH_LOG_NOLOG:
+        np2_priority = LOG_ERR;
+        break;
+    case SSH_LOG_WARNING:
+        np2_priority = LOG_WARNING;
+        break;
+    case SSH_LOG_PROTOCOL:
+        np2_priority = LOG_INFO;
+        break;
+    case SSH_LOG_PACKET:
+    case SSH_LOG_FUNCTIONS:
+        np2_priority = LOG_DEBUG;
+        break;
+    }
+
+    np2log(np2_priority, "SH", "%s%s%s", yellow, buffer, reset);
+}
