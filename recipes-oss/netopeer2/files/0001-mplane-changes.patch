+/* /if:interfaces/if:interface/ip:ipv4/o-ran-int:m-plane-marking */
+/* /if:interfaces/if:interface/ip:ipv6/o-ran-int:m-plane-marking */
+int
+np2srv_m_plane_marking(sr_session_ctx_t *session, const char *UNUSED(module_name), const char *xpath,
+        sr_event_t UNUSED(event), uint32_t UNUSED(request_id), void *UNUSED(private_data))
+{
+    #define MAX_NAME_LEN 255
+    #define MAX_CLIENT_COUNT 50
+    #define MAX_XPATH_LEN 1024
+    char *client_addr[MAX_CLIENT_COUNT];
+    uint8_t client_dscp[MAX_CLIENT_COUNT];
+    uint8_t client_count = 0;
+    sr_val_t *if_names = NULL;
+    static size_t name_count = 0;
+    static char if_name[MAX_CLIENT_COUNT][MAX_NAME_LEN] = {0};
+    int rc = SR_ERR_OK;
+    char *ip_type = NULL;
+    if (strstr(xpath, "ipv4"))
+    {
+        ip_type = "ipv4";
+    }
+    else
+    {
+        ip_type = "ipv6";
+    }
+
+
+    // get list of all IP and corresponding DSCP configured by M-plane
+    nc_server_get_address_and_dscp_list(client_addr, client_dscp, &client_count, MAX_CLIENT_COUNT);
+
+    // lets now fetch all the ietf-interfaces configured by QNCM
+    // we need to fetch this only first time, as this will never change
+    if (if_name[0][0] == 0)
+    {
+        rc = sr_get_items(session, "/ietf-interfaces:interfaces/ietf-interfaces:interface/ietf-interfaces:name", 1000, 0, &if_names, &name_count);
+        if (rc != SR_ERR_OK)
+        {
+            goto error;
+        }
+
+        for (uint8_t name_idx = 0; name_idx < name_count; name_idx++)
+        {
+            VRB("interface: %s", if_names[name_idx].data.string_val);
+            snprintf(if_name[name_idx], MAX_NAME_LEN, "%s", if_names[name_idx].data.string_val);
+        }
+        sr_free_values(if_names, name_count);
+    }
+
+    for (uint8_t name_idx = 0; name_idx < name_count; name_idx++)
+    {
+        // get list of IPs for each interface
+        char ip_addr_xpath[MAX_XPATH_LEN];
+        sr_val_t *ips = NULL;
+        size_t ip_count = 0;
+        snprintf(ip_addr_xpath, MAX_XPATH_LEN, "/ietf-interfaces:interfaces/ietf-interfaces:interface[name=\"%s\"]/ietf-ip:%s/ietf-ip:address/ietf-ip:ip", if_name[name_idx], ip_type);
+        VRB("ip addr xpath: %s", ip_addr_xpath);
+        rc = sr_get_items(session, ip_addr_xpath, 1000, 0, &ips, &ip_count);
+        if (rc != SR_ERR_OK)
+        {
+            goto error;
+        }
+
+        for (uint8_t ip_idx = 0; ip_idx < ip_count; ip_idx++)
+        {
+            VRB("interface: %s -> ip: %s", if_name[name_idx], ips[ip_idx].data.string_val);
+            // check if this IP matches with any of the configured IP for mplane
+            for (uint8_t client_idx = 0; client_idx < client_count; client_idx++)
+            {
+                if (!strcmp(ips[ip_idx].data.string_val, client_addr[client_idx]))
+                {
+                    char dscp_xpath[MAX_XPATH_LEN];
+                    snprintf(dscp_xpath, MAX_XPATH_LEN, "/ietf-interfaces:interfaces/ietf-interfaces:interface[name=\"%s\"]/ietf-ip:%s/o-ran-interfaces:m-plane-marking", if_name[name_idx], ip_type);
+                    VRB("dscp xpath: %s", dscp_xpath);
+                    uint8_t new_dscp = client_dscp[client_idx];
+                    sr_val_t *marking = NULL;
+                    rc = sr_get_item(session, dscp_xpath, 1000, &marking);
+                    if (rc != SR_ERR_OK)
+                    {
+                        sr_free_values(ips, ip_count);
+                        goto error;
+                    }
+                    new_dscp = marking->data.uint8_val;
+                    if (client_dscp[client_idx] == new_dscp)
+                    {
+                        VRB("no need to update socket");
+                    }
+                    else
+                    {
+                        VRB("addr: %s, old dscp: %d, new dscp: %d", client_addr[client_idx], client_dscp[client_idx], new_dscp);
+                        rc = nc_server_update_m_plane_marking(client_addr[client_idx], new_dscp);
+                        if (rc != 0)
+                        {
+                            ERR("failed to update the dscp");
+                        }
+                    }
+                    sr_free_val(marking);
+                }
+            }
+        }
+        sr_free_values(ips, ip_count);
+    }
+
+    error:
+        for (uint8_t i = 0; i < client_count; i++)
+        {
+            free(client_addr[i]);
+        }
+        return rc;
+}
