+
+typedef struct {
+    char ip[INET6_ADDRSTRLEN + 1]; // For /0
+    uint8_t dscp;
+} mplane_ip_dscp_entry_t;
+
+typedef struct {
+    int16_t ip_dscp_entries_number; // Number of valid entries
+    mplane_ip_dscp_entry_t entries[MAX_CLIENT_COUNT];
+} mplane_ip_dscp_list_t;
+
+/**
+ * @brief Retrieve the list of local interface IP addresses and their associated DSCP values.
+ *
+ * This function queries sysrepo for all configured network interfaces, extracts each interface's
+ * local IP address (IPv4 or IPv6) and its corresponding DSCP (Differentiated Services Code Point)
+ * marking, and populates the provided @p ip_dscp_list structure with the results.
+ *
+ * The function iterates through all interfaces found at the path "/ietf-interfaces:interfaces/ietf-interfaces:interface",
+ * checks for both IPv6 and IPv4 addresses, and fetches the DSCP marking from the appropriate YANG node.
+ * Only interfaces with both a local address and a DSCP marking are included in the output list.
+ *
+ * @param[in]  session      Sysrepo session context used for data retrieval.
+ * @param[out] ip_dscp_list Pointer to a structure to be filled with IP/DSCP pairs.
+ *
+ * @retval 0               Success; @p ip_dscp_list is populated.
+ * @retval -1              Invalid arguments.
+ * @retval SR_ERR_INTERNAL Sysrepo or libyang error during data retrieval or parsing.
+ *
+ * @note The function clears @p ip_dscp_list before populating it.
+ *       The number of valid entries is stored in ip_dscp_list->ip_dscp_entries_number.
+ *       The function ensures all IP strings are null-terminated.
+ *       Only interfaces with both a local address and DSCP marking are included.
+ */
+int
+np2srv_m_mplane_get_dscp_local_address_list(
+                                    sr_session_ctx_t *session,
+                                    mplane_ip_dscp_list_t *ip_dscp_list)
+{
+    int ret = 0, count = 0;
+    struct lyd_node *ietf_interface_data = NULL, *ietf_interface_node = NULL;
+    struct ly_set *ietf_interface_set = NULL;
+    const char* interface_xpath = "/ietf-interfaces:interfaces/"
+                                  "ietf-interfaces:interface";
+
+    if (!session || !ip_dscp_list)
+    {
+        ERR("Invalid arguments, session %p, ip_dscp_list %p",
+            session,
+            ip_dscp_list);
+        return -1;
+    }
+
+    memset(ip_dscp_list, 0, sizeof(mplane_ip_dscp_list_t));
+
+    VRB("Get local address and dscp correspondence");
+    // Fetch all the ietf-interfaces configured in sysrepo
+    VRB("Fetch sysrepo data for path %s", interface_xpath);
+    ret = sr_get_data(session, interface_xpath, 0, np2srv.sr_timeout, 0,
+                      &ietf_interface_data);
+    if (ret != 0 || !ietf_interface_data)
+    {
+        ERR("Unable to get data from sysrepo (%s)", sr_strerror(ret));
+        return SR_ERR_INTERNAL;
+    }
+
+    char *xml_buf = NULL;
+    int rc = lyd_print_mem(&xml_buf, ietf_interface_data, LYD_XML, LYP_FORMAT | LYP_WD_ALL);
+    if (rc == 0 && xml_buf)
+    {
+        VRB("ietf-interface data:\n%s", xml_buf); // This will print the full XML tree
+        free(xml_buf);
+    }
+    else
+    {
+        ERR("Failed to serialize data tree to XML");
+        // We don't return as it is only the print which failed
+    }
+
+    // Data is giving the node of the top container, we need to get the set from
+    //  the xpath /ietf-interfaces:interfaces/ietf-interfaces:interface
+    ietf_interface_set = lyd_find_path(ietf_interface_data, interface_xpath);
+    if (!ietf_interface_set)
+    {
+        ERR("Unable to get ly_set from data provided by sysrepo");
+        lyd_free_withsiblings(ietf_interface_data);
+        return SR_ERR_INTERNAL;
+    }
+
+    // Go over all interface
+    for (unsigned int interface_idx = 0;
+         interface_idx < ietf_interface_set->number;
+         interface_idx++)
+    {
+        const char* mplane_marking_xpath = NULL;
+        ietf_interface_node = ietf_interface_set->set.d[interface_idx];
+        if (!ietf_interface_node)
+        {
+            ERR("ietf_interface_node is NULL");
+            continue;
+        }
+
+        // Get local-address which will be on the path ip:ipv4/ip:address/ip:ip
+        //  or ip:ipv6/ip:address/ip:ip
+        const char* ip6_path = "ietf-ip:ipv6/ietf-ip:address/ietf-ip:ip";
+        const char* ip;
+        ret = np2srv_mplane_ch_get_first_value_str(ietf_interface_node,
+                                                   ip6_path,
+                                                   &ip);
+        if (ret == 0)
+        {
+            mplane_marking_xpath =
+                                "ietf-ip:ipv6/o-ran-interfaces:m-plane-marking";
+        }
+        else
+        {
+            // ipv6 is not defined. Try ipv4
+            const char* ip4_path =  "ietf-ip:ipv4/ietf-ip:address/ietf-ip:ip";
+            ret = np2srv_mplane_ch_get_first_value_str(ietf_interface_node,
+                                                    ip4_path,
+                                                    &ip);
+            if (ret != 0)
+            {
+                // no local address is defined for this interface
+                continue;
+            }
+            mplane_marking_xpath =
+                                "ietf-ip:ipv4/o-ran-interfaces:m-plane-marking";
+        }
+        VRB("value of local-address for this interface: %s", ip);
+
+        // Now get the mplane-marking
+        uint8_t dscp;
+
+        ret = np2srv_mplane_ch_get_first_value_uint8(ietf_interface_node,
+                                                     mplane_marking_xpath,
+                                                    &dscp);
+        if (ret != 0)
+        {
+            WRN("dscp not defined for address %s", ip);
+            continue;
+        }
+
+        VRB("Got dscp %d, for local-address %s", dscp, ip);
+
+        // Fill the structure
+        ip_dscp_list->entries[count].dscp = dscp;
+        snprintf(ip_dscp_list->entries[count].ip,INET6_ADDRSTRLEN,"%s", ip);
+        ip_dscp_list->entries[count].ip[INET6_ADDRSTRLEN - 1] = '\0'; // Ensure null-termination
+        ip_dscp_list->ip_dscp_entries_number++;
+        count++;
+    }
+    VRB("Got %d local-addresses with dscp", count);
+    ly_set_free(ietf_interface_set);
+    lyd_free_withsiblings(ietf_interface_data);
+    return 0;
+}
+
+/**
+ * @brief Sysrepo callback for updating NETCONF call-home client configuration.
+ *
+ * This callback is invoked by sysrepo when the NETCONF client configuration
+ * changes. It retrieves the NETCONF client data tree, parses relevant
+ * parameters (such as endpoints, authentication methods, connection type,
+ * keepalive settings, etc.), and updates the libnetconf2 server accordingly.
+ *
+ * @param[in]  session       Sysrepo session context.
+ * @param[in]  module_name   Name of the YANG module (unused).
+ * @param[in]  xpath         XPath to the NETCONF client container.
+ * @param[in]  event         Sysrepo event type (unused).
+ * @param[in]  request_id    Sysrepo request ID (unused).
+ * @param[in]  private_data  User private data (unused).
+ *
+ * @return SR_ERR_OK (0) on success, SR_ERR_INTERNAL on error.
+ */
+int np2srv_mplane_ch_netconf_client_cb(sr_session_ctx_t *session,
+                                       const char *UNUSED(module_name),
+                                       const char *xpath,
+                                       sr_event_t UNUSED(event),
+                                       unsigned int UNUSED(request_id),
+                                       void *UNUSED(private_data))
+{
+    int ret = 0, auth = 0, conn_type = 0;
+    struct lyd_node *netconf_client_data, *netconf_client_node, *endpoint_node;
+    struct ly_set * netconf_client_set;
+    const char *client_name, *endpt_name;
+    const char *remote_address, *local_address;
+    const char *keystore_ref;
+    const char *conn_type_anchor_time;
+    uint16_t conn_type_period, conn_type_idle_timeout, local_port, remote_port;
+    uint16_t ka_idle_time, ka_max_probes, ka_probe_interval;
+    VRB("New data for netconf-client. Disable all call home thread");
+    // We call the function to pause all call home threads
+    ret = nc_mplane_pause_ch_threads();
+    if (ret != 0)
+    {
+        // We can continue, the only thing it will change is the deletion
+        //  operation won't really work as the call home thread  will continue
+        //  to run
+        ERR("Unable to pause call home threads. Continue anyway");
+    }
+
+    ret = nc_mplane_empty_ch_client_endpoints();
+    if (ret != 0)
+    {
+        // We can continue, the only issue it will be that extra node won't
+        //  be deleted
+        ERR("Unable to remove content of netconf-client into libnetconf2");
+    }
+
+    // Get all data.
+    ret = sr_get_data(session, xpath, 0, np2srv.sr_timeout, 0,
+                     &netconf_client_data);
+    if (ret != 0)
+    {
+        ERR("Unable to get data from sysrepo(%s).", sr_strerror(ret));
+        return SR_ERR_INTERNAL;
+    }
+
+    if (!netconf_client_data)
+    {
+        ERR("Data provided by sysrepo is not usable.");
+        return SR_ERR_INTERNAL;
+    }
+
+    char *xml_buf = NULL;
+    int rc = lyd_print_mem(&xml_buf, netconf_client_data, LYD_XML, LYP_FORMAT | LYP_WD_ALL);
+    if (rc == 0 && xml_buf)
+    {
+        VRB("netconf-client-data:\n%s", xml_buf); // This will print the full XML tree
+        free(xml_buf);
+    }
+    else
+    {
+        ERR("Failed to serialize data tree to XML");
+        // We don't return as it is only the print which failed
+    }
+    // Data is giving the node of the top container, we need to get the set from
+    //  the xpath /ietf-netconf-server:netconf-server/call-home/netconf-client
+    netconf_client_set = lyd_find_path(netconf_client_data, xpath);
+    if (!netconf_client_set)
+    {
+        ERR("Unable to get ly_set from data provided by sysrepo");
+        lyd_free_withsiblings(netconf_client_data);
+        return SR_ERR_INTERNAL;
+    }
+
+    mplane_ip_dscp_list_t dscp_list;
+    np2srv_m_mplane_get_dscp_local_address_list(session, &dscp_list);
+
+    // Going on all the data of the set and applying the changes
+    for (unsigned int index = 0; index < netconf_client_set->number; index++)
+    {
+        netconf_client_node = netconf_client_set->set.d[index];
+        if (!netconf_client_node)
+        {
+            ERR("netconf_client_node is NULL");
+            continue;
+        }
+
+        ret = np2srv_mplane_ch_get_first_value_str(netconf_client_node,
+                                                   "name",
+                                                   &client_name);
+        if (ret != 0)
+        {
+            ERR("Error while retrieving client name");
+            continue;
+        }
+
+        // For connection_type it's not a value of a leaf but the leaf itself
+        struct ly_set *conn_type_subset =
+                                    lyd_find_path(netconf_client_node,
+                                    "connection-type");
+        if (!conn_type_subset || conn_type_subset->number == 0)
+        {
+            ERR("Error while retrieving connection-type");
+            continue;
+        }
+        struct lyd_node* conn_type_node = conn_type_subset->set.d[0]->child;
+        if (!conn_type_node)
+        {
+            ERR("No connection type");
+            continue;
+        }
+        if (!strcmp(conn_type_node->schema->name, "persistent"))
+        {
+            conn_type = NC_CH_PERSIST;
+        }
+        else if (!strcmp(conn_type_node->schema->name, "periodic"))
+        {
+            conn_type = NC_CH_PERIOD;
+
+            // In that case we need to get the period, anchor-time,
+            //   and idle-timeout
+
+            const char* conn_type_period_xpath =
+                                            "connection-type/periodic/period";
+            ret = np2srv_mplane_ch_get_first_value_uint16(
+                                                        netconf_client_node,
+                                                        conn_type_period_xpath,
+                                                        &conn_type_period);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving connection type period");
+                ly_set_free(conn_type_subset);
+                continue;
+            }
+
+            const char* conn_type_anchor_time_xpath =
+                                        "connection-type/periodic/anchor-time";
+            ret = np2srv_mplane_ch_get_first_value_str(
+                                                    netconf_client_node,
+                                                    conn_type_anchor_time_xpath,
+                                                    &conn_type_anchor_time);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving connection type anchor time");
+                ly_set_free(conn_type_subset);
+                continue;
+            }
+
+            const char* conn_type_idle_timeout_xpath =
+                                        "connection-type/periodic/idle-timeout";
+            ret = np2srv_mplane_ch_get_first_value_uint16(
+                                                    netconf_client_node,
+                                                    conn_type_idle_timeout_xpath,
+                                                    &conn_type_idle_timeout);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving connection type idle-timeout");
+                ly_set_free(conn_type_subset);
+                continue;
+            }
+        }
+        else
+        {
+            ERR("Unsupported connection type %s", conn_type_node->schema->name);
+            ly_set_free(conn_type_subset);
+            continue;
+        }
+        ly_set_free(conn_type_subset);
+
+        // We need to create the netconf-client right now. Because we will
+        //  go over all endpoints after that
+
+
+        ret = nc_mplane_server_ch_add_client_if_not_exist(client_name);
+        if (ret != 0)
+        {
+            ERR("Unable to create client on libnetconf2");
+            continue;
+        }
+
+        // As we create the netconf-client we can set up the connection type
+        ret = nc_server_ch_client_set_conn_type(client_name, conn_type);
+        if (ret != 0)
+        {
+            ERR("Unable to set connection type");
+            continue;
+        }
+
+        if (conn_type == NC_CH_PERIOD)
+        {
+            // In that case we need to fill data for period, anchor-time, and
+            //  idle-timeout
+            ret = nc_server_ch_client_periodic_set_period(client_name,
+                                                          conn_type_period);
+            if (ret != 0)
+            {
+                ERR("Unable to set connection type period");
+                continue;
+            }
+            ret = nc_server_ch_client_periodic_set_anchor_time(
+                                    client_name,
+                                    nc_datetime2time(conn_type_anchor_time));
+            if (ret != 0)
+            {
+                ERR("Unable to set connection type anchor-time");
+                continue;
+            }
+            ret = nc_server_ch_client_periodic_set_idle_timeout(
+                                                        client_name,
+                                                        conn_type_idle_timeout);
+            if (ret != 0)
+            {
+                ERR("Unable to set connection type idle-timeout");
+                continue;
+            }
+        }
+
+        // Go over all endpoints
+        struct ly_set *endpoints_set = lyd_find_path(netconf_client_node,
+                                                     "endpoints/endpoint");
+        if (!endpoints_set)
+        {
+            ERR("set of endpoints is NULL");
+            continue;
+        }
+
+        for (uint16_t endpt_idx = 0;
+             endpt_idx < endpoints_set->number;
+             endpt_idx++)
+        {
+            endpoint_node = endpoints_set->set.d[endpt_idx];
+            if (!endpoint_node)
+            {
+                ERR("endpoint node is NULL");
+            }
+
+            // Fetch all the data
+            ret = np2srv_mplane_ch_get_first_value_str(endpoint_node,
+                                                       "name",
+                                                       &endpt_name);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving endpt_name");
+                continue;
+            }
+
+            ret = np2srv_mplane_ch_get_first_value_str(
+                    endpoint_node,
+                    "ssh/tcp-client-parameters/remote-address",
+                    &remote_address);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving remote-address");
+                continue;
+            }
+
+            ret = np2srv_mplane_ch_get_first_value_uint16(
+                    endpoint_node,
+                    "ssh/tcp-client-parameters/remote-port",
+                    &remote_port);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving remote-port");
+                continue;
+            }
+
+            ret = np2srv_mplane_ch_get_first_value_str(
+                    endpoint_node,
+                    "ssh/tcp-client-parameters/local-address",
+                    &local_address);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving local-address");
+                continue;
+            }
+
+            ret = np2srv_mplane_ch_get_first_value_uint16(
+                    endpoint_node,
+                    "ssh/tcp-client-parameters/local-port",
+                    &local_port);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving local-port");
+                continue;
+            }
+
+            const char *keystore_xpath =
+                        "ssh/ssh-server-parameters/"
+                        "server-identity/host-key/public-key/keystore-reference";
+
+            ret = np2srv_mplane_ch_get_first_value_str(endpoint_node,
+                                                       keystore_xpath,
+                                                       &keystore_ref);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving keystore-reference");
+                continue;
+            }
+
+            // For the authmethod we need to get the node itself
+            const char* auth_methods_xpath =
+                        "ssh/ssh-server-parameters/client-authentication"
+                        "/supported-authentication-methods";
+
+            struct ly_set *auth_subset = lyd_find_path(endpoint_node,
+                                                       auth_methods_xpath);
+            if (!auth_subset || auth_subset->number == 0)
+            {
+                ERR("Error while retrieving supported-authentication-methods");
+                if (auth_subset)
+                {
+                    ly_set_free(auth_subset);
+                }
+                continue;
+            }
+
+            for (unsigned int index = 0; index < auth_subset->number; index++)
+            {
+                struct lyd_node *auth_method_node = auth_subset->set.d[index];
+                if (!auth_method_node)
+                {
+                    ERR("auth_method_node is nullptr");
+                    continue;
+                }
+
+                // The node is still <supported-authentication-methods, but we want
+                //  to go through the children
+                struct lyd_node *method_node = auth_method_node->child;
+
+                for( ;method_node;method_node = method_node->next)
+                {
+                    if (!(method_node->schema))
+                    {
+                        ERR("method_node or method_node->schema is null");
+                        continue;
+                    }
+                    if (!strcmp(method_node->schema->name, "publickey"))
+                    {
+                        auth |= NC_SSH_AUTH_PUBLICKEY;
+                    }
+                    // Typo passSword is coming from yang module
+                    else if (!strcmp(method_node->schema->name, "passsword"))
+                    {
+                        auth |= NC_SSH_AUTH_PASSWORD;
+                    }
+                    else if (!strcmp(method_node->schema->name, "other"))
+                    {
+                        if (method_node->schema->nodetype != LYS_LEAF &&
+                            method_node->schema->nodetype != LYS_LEAFLIST)
+                        {
+                            ERR("Node is neither LYS_LEAF nor LYS_LEAFLIST");
+                            continue;
+                        }
+
+                        struct lyd_node_leaf_list *auth_leaf =
+                                        (struct lyd_node_leaf_list *) method_node;
+                        if (!strcmp(auth_leaf->value_str, "interactive"))
+                        {
+                            auth |= NC_SSH_AUTH_INTERACTIVE;
+                        } else {
+                            WRN("SSH authentication \"%s\" not supported.",
+                                auth_leaf->value_str);
+                        }
+                    }
+                    else
+                    {
+                        WRN("SSH authentication \"%s\" not supported.",
+                            method_node->schema->name);
+                    }
+                }
+            }
+            ly_set_free(auth_subset);
+
+
+            const char* ka_idle_time_xpath =
+                            "ssh/tcp-client-parameters/keepalives/idle-time";
+            ret = np2srv_mplane_ch_get_first_value_uint16(endpoint_node,
+                                                          ka_idle_time_xpath,
+                                                          &ka_idle_time);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving keepalives idle-time");
+                continue;
+            }
+            const char* ka_max_probes_xpath =
+                                    "ssh/tcp-client-parameters"
+                                    "/keepalives/max-probes";
+            ret = np2srv_mplane_ch_get_first_value_uint16(endpoint_node,
+                                                          ka_max_probes_xpath,
+                                                          &ka_max_probes);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving keepalives max_probes");
+                continue;
+            }
+            const char* ka_probe_interval_xpath =
+                                                "ssh/tcp-client-parameters"
+                                                "/keepalives/probe-interval";
+            ret = np2srv_mplane_ch_get_first_value_uint16(
+                                                        endpoint_node,
+                                                        ka_probe_interval_xpath,
+                                                        &ka_probe_interval);
+            if (ret != 0)
+            {
+                ERR("Error while retrieving keepalives probe interval");
+                continue;
+            }
+
+            // Now all the data for the endpoint is fetch. We can set it to LN2
+
+            // Currently we support only SSH. The flag NC_TI_LIBSSH is coming from
+            //  np2srv_ch_client_endpt_ssh_cb()
+            ret = nc_server_ch_client_add_endpt(client_name,
+                                                endpt_name,
+                                                NC_TI_LIBSSH);
+            if (ret != 0)
+            {
+                ERR("Unable to add endpt on libnetconf2");
+                continue;
+            }
+
+            // Turn off all auth methods by default, we will update it later
+            ret = nc_server_ssh_ch_client_endpt_set_auth_methods(client_name,
+                                                                 endpt_name,
+                                                                 0);
+            if (ret != 0)
+            {
+                ERR("Unable to set auth method");
+                continue;
+            }
+
+            ret = nc_server_ch_client_endpt_set_address(client_name,
+                                                        endpt_name,
+                                                        remote_address);
+            if (ret != 0)
+            {
+                ERR("Unable to set remote address");
+                continue;
+            }
+
+            ret = nc_server_ch_client_endpt_set_port(client_name,
+                                                     endpt_name,
+                                                     remote_port);
+            if (ret != 0)
+            {
+                ERR("Unable to set remote port");
+                continue;
+            }
+
+            ret = nc_server_ch_client_endpt_set_local_address(client_name,
+                                                             endpt_name,
+                                                             local_address);
+            if (ret != 0)
+            {
+                ERR("Unable to set local address");
+                continue;
+            }
+
+            ret = nc_server_ch_client_endpt_set_local_port(client_name,
+                                                           endpt_name,
+                                                           local_port);
+            if (ret != 0)
+            {
+                ERR("Unable to set local port");
+                continue;
+            }
+
+            // The -1 is used to update the last hostkey in the list
+            ret = nc_server_ssh_ch_client_endpt_add_hostkey(client_name,
+                                                            endpt_name,
+                                                            keystore_ref,
+                                                            -1);
+            if (ret != 0)
+            {
+                ERR("Unable to set hostkey");
+                continue;
+            }
+
+            ret = nc_server_ssh_ch_client_endpt_set_auth_methods(client_name,
+                                                                 endpt_name,
+                                                                 auth);
+            if (ret != 0)
+            {
+                ERR("Unable to set authentication methods");
+                continue;
+            }
+
+            // Enable keepalives
+            ret = nc_server_ch_client_endpt_enable_keepalives(client_name,
+                                                              endpt_name,
+                                                              1);
+            if (ret != 0)
+            {
+                ERR("Unable to enable keepalives");
+                continue;
+            }
+
+            ret = nc_server_ch_client_endpt_set_keepalives(
+                                                    client_name,
+                                                        endpt_name,
+                                                        ka_idle_time,
+                                                        ka_max_probes,
+                                                        ka_probe_interval);
+            if (ret != 0)
+            {
+                ERR("Unable to set keepalives parameters");
+                continue;
+            }
+
+            // Now we want to add the dscp if needed
+            for (uint16_t ip_idx = 0;
+                 ip_idx < dscp_list.ip_dscp_entries_number;
+                 ip_idx++)
+            {
+                if (!strcmp(dscp_list.entries[ip_idx].ip, local_address))
+                {
+                    // Found dscp for this endpoint
+                    ret = nc_mplane_server_ch_client_endpt_set_dscp(
+                                                client_name,
+                                                endpt_name,
+                                                dscp_list.entries[ip_idx].dscp);
+                    if (ret != 0)
+                    {
+                        ERR("failed to update the dscp");
+                    }
+                    break;
+                }
+            }
+            // Go to next endpoint
+        } // Loop through all endpoints
+
+        ly_set_free(endpoints_set);
+
+        // Now we can resume or create call home thread
+        ret = nc_mplane_ch_client_resume_or_dispatch(client_name,
+                                                     np2srv_new_session_cb);
+        if (ret != 0)
+        {
+            ERR("Unable to resume or dispatch call home thread for client %s",
+                client_name);
+            continue;
+        }
+    } // Loop through netconf-clients
+
+    lyd_free_withsiblings(netconf_client_data);
+    ly_set_free(netconf_client_set);
+
+    return SR_ERR_OK;
+}
