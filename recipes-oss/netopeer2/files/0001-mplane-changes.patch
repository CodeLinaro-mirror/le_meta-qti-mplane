+/* /o-ran-operations:operational-info/re-call-home-no-ssh-timer */
+int
+np2srv_re_call_home_no_ssh_timer(sr_session_ctx_t *session, const char *UNUSED(module_name), const char *xpath,
+        sr_event_t UNUSED(event), uint32_t UNUSED(request_id), void *UNUSED(private_data))
+{
+    sr_val_t *value = NULL;
+
+    /*1000 is a timeout value (in ms) that will be used in
+    pthread_cond_timedwait(). I used 1000 as this value is used at multiple
+    places, if 0 is pssed the default value 5000 is used.*/
+
+    int rc = sr_get_item(session, xpath, 1000, &value);
+    if (rc != SR_ERR_OK)
+    {
+        return rc;
+    }
+    nc_server_update_re_call_home_no_ssh_timer(value->data.uint16_val);
+
+    return SR_ERR_OK;
+}
+
+void
+call_home_attempts_exceeded_clb(void)
+{
+    sr_val_t *output = NULL;
+    size_t output_count = 0;
+    int rc;
+
+    ERR("call_home_attempts_exceeded_clb called");
+
+    rc = sr_rpc_send(np2srv.sr_sess, "/o-ran-operations:reset", NULL, 0,
+                     np2srv.sr_timeout ? np2srv.sr_timeout + 2000 : 0,
+                     &output, &output_count);
+    if (rc != SR_ERR_OK) {
+        ERR("Failed to send an RPC (%s).", sr_strerror(rc));
+    }
+    else {
+         sr_free_values(output, output_count);
+    }
+}
+
+int
+np2srv_max_call_home_attempts(sr_session_ctx_t *session, const char *UNUSED(module_name), const char *xpath,
+        sr_event_t UNUSED(event), uint32_t UNUSED(request_id), void *UNUSED(private_data))
+{
+    sr_val_t *value = NULL;
+
+    int rc = sr_get_item(session, xpath, 1000, &value);
+    if (rc != SR_ERR_OK)
+    {
+        return rc;
+    }
+    nc_server_update_max_call_home_attempts(value->data.uint8_val,
+                                            call_home_attempts_exceeded_clb);
+
+    return SR_ERR_OK;
+}
