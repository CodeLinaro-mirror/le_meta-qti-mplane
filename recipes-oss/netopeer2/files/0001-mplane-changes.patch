+/**
+ * @brief Retrieve the first leaf or leaf-list node from a ly_set.
+ *
+ * This function extracts the first node from the provided ly_set and, if it is
+ * of type LYS_LEAF or LYS_LEAFLIST, assigns it to the output parameter as a
+ * struct lyd_node_leaf_list pointer.
+ *
+ * @param[in]  set        Pointer to the ly_set to search (must not be NULL).
+ * @param[out] leaf_list  Address of a pointer to receive the first leaf or
+ *                        leaf-list node (set to NULL on error).
+ *
+ * @return 0 on success, -1 on error (invalid arguments or node type mismatch).
+ */
+int
+np2srv_mplane_get_first_node_list_from_node(
+                                        const struct ly_set* set,
+                                        struct lyd_node_leaf_list** leaf_list)
+{
+    if (!set || set->number == 0)
+    {
+        ERR("Set %p provided is NULL or doesn't contain any leaf", set);
+        return -1;
+    }
+
+    if (!leaf_list)
+    {
+        ERR("leaf_list provided is NULL");
+        return -1;
+    }
+
+    // Get the node of the first item
+    struct lyd_node* extract_node = set->set.d[0];
+    if (!extract_node || !(extract_node->schema) ||
+            (extract_node->schema->nodetype != LYS_LEAF &&
+            extract_node->schema->nodetype != LYS_LEAFLIST))
+    {
+        ERR("Node is neither LYS_LEAF nor LYS_LEAFLIST");
+        return -1;
+    }
+
+    *leaf_list = (struct lyd_node_leaf_list *)(extract_node);
+    return 0;
+}
+
+/**
+ * @brief Retrieve the string value of the first leaf matching an XPath.
+ *
+ * This function searches for the first node matching the given XPath under the
+ * specified data tree node. If found and is a leaf or leaf-list, its string
+ * value is returned via the output parameter.
+ *
+ * @param[in]  node   Root node to search from (must not be NULL).
+ * @param[in]  xpath  XPath expression to locate the leaf.
+ * @param[out] value  Address of a pointer to receive the string value.
+ *
+ * @return 0 on success, -1 on error (not found, wrong type, or invalid args).
+ */
+int
+np2srv_mplane_ch_get_first_value_str(const struct lyd_node* node,
+                                     const char *xpath,
+                                     const char** value)
+{
+    if (!node || !xpath || !value)
+    {
+        ERR("Incorrect parameters. node %p, xpath %p, value %p",
+            node, xpath, value);
+        return -1;
+    }
+
+    // Search for the subset
+    struct ly_set *subset;
+    subset = lyd_find_path(node, xpath);
+    if (!subset || subset->number == 0)
+    {
+        ERR("Unable to get subset for xpath %s", xpath);
+        if (subset)
+        {
+            ly_set_free(subset);
+        }
+        return -1;
+    }
+
+    struct lyd_node_leaf_list *extract;
+    int ret = np2srv_mplane_get_first_node_list_from_node(subset, &extract);
+    if (ret != 0)
+    {
+        ERR("Unable to get lyd_node_leaf_list");
+        return -1;
+    }
+
+    if (!extract)
+    {
+        ERR("Unable to get first item of the subset on xpath %s", xpath);
+        ly_set_free(subset);
+        return -1;
+    }
+
+    *value = extract->value_str;
+    ly_set_free(subset);
+
+    return 0;
+}
+
+/**
+ * @brief Retrieve the uint16 value of the first leaf matching an XPath.
+ *
+ * This function searches for the first node matching the given XPath under the
+ * specified data tree node. If found and is a leaf or leaf-list, its uint16
+ * value is returned via the output parameter.
+ *
+ * @param[in]  node   Root node to search from (must not be NULL).
+ * @param[in]  xpath  XPath expression to locate the leaf.
+ * @param[out] value  Pointer to uint16_t to receive the value.
+ *
+ * @return 0 on success, -1 on error (not found, wrong type, or invalid args).
+ */
+int
+np2srv_mplane_ch_get_first_value_uint16(const struct lyd_node* node,
+                                        const char *xpath,
+                                        uint16_t* value)
+{
+    if (!node || !xpath || !value)
+    {
+        ERR("Incorrect parameters. node %p, xpath %p, value %p",
+            node, xpath, value);
+        return -1;
+    }
+
+    // Search for the subset
+    struct ly_set *subset;
+    subset = lyd_find_path(node, xpath);
+    if (!subset || subset->number == 0)
+    {
+        ERR("Unable to get subset for xpath %s", xpath);
+        if (subset)
+        {
+            ly_set_free(subset);
+        }
+        return -1;
+    }
+
+
+    struct lyd_node_leaf_list *extract;
+    int ret = np2srv_mplane_get_first_node_list_from_node(subset, &extract);
+    if (ret != 0)
+    {
+        ERR("Unable to get lyd_node_leaf_list");
+        return -1;
+    }
+    if (!extract)
+    {
+        ERR("Unable to get first item of the subset on xpath %s", xpath);
+        ly_set_free(subset);
+        return -1;
+    }
+
+    *value = extract->value.uint16;
+    ly_set_free(subset);
+
+    return 0;
+}
