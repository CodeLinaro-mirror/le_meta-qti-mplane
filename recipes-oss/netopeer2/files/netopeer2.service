[Unit]
Description=netopeer2-service
After=mplane-yang-module-installer.service
Requires=mplane-yang-module-installer.service

[Service]
ExecStart=/usr/bin/netopeer2-server -v4 -d -p /tmp/netopeer2-server.pid
User=radio
Group=radio
SecureBits=keep-caps
SupplementaryGroups=diag
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target